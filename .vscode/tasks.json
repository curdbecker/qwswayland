{
    "version": "2.0.0",
    "tasks": [
        // ---------------------------------------------------------------
        // weston (VNC)
        //   Starts a Weston compositor with VNC backend on port 5900.
        // ---------------------------------------------------------------
        {
            "label": "weston (VNC)",
            "type": "shell",
            "command": "weston -S /tmp/xdg/wayland-0 -B vnc --disable-transport-layer-security --port=5900 --idle-time=0 --width=1024 --height=768",
            "options": {
                "cwd": "/tmp",
                "env": {
                    "XDG_RUNTIME_DIR": "/tmp/xdg",
                    "WAYLAND_DEBUG": "0"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // trace: 1. QWS Server
        //   Starts the example app as the QWS server on display 1.
        //   Socket appears at /tmp/qtembedded-0/QtEmbedded-1.
        // ---------------------------------------------------------------
        {
            "label": "trace: 1. QWS Server",
            "type": "shell",
            "command": "${workspaceFolder}/builddir/example/example -qws -display VNC:size=1024x768:depth=32:1",
            "options": {
                "cwd": "/tmp",
                "env": {
                    "LD_LIBRARY_PATH": "/usr/local/Trolltech/QtEmbedded-4.8.7-generic/lib"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "qws-trace"
            },
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // trace: 2. Proxy
        //   Waits for the server socket, then starts the trace proxy
        //   listening on display 2 and forwarding to display 1.
        // ---------------------------------------------------------------
        {
            "label": "trace: 2. Proxy",
            "type": "shell",
            "command": "until [ -S /tmp/qtembedded-0/QtEmbedded-0 ]; do sleep 0.2; done && ${workspaceFolder}/builddir/trace_proxy/qws_trace_proxy -l 2 -u 1 -w capture.pcapng -vvv",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "qws-trace"
            },
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // trace: 3. QWS Client
        //   Waits for the proxy socket, then starts the example app as a
        //   QWS client connecting via the trace proxy on display 2.
        // ---------------------------------------------------------------
        {
            "label": "trace: 3. QWS Client",
            "type": "shell",
            "command": "until [ -S /tmp/qtembedded-1/QtEmbedded-1 ]; do sleep 0.2; done && ${workspaceFolder}/builddir/example/example",
            "options": {
                "cwd": "/tmp",
                "env": {
                    "LD_LIBRARY_PATH": "/usr/local/Trolltech/QtEmbedded-4.8.7-generic/lib",
                    "QWS_DISPLAY": ":2"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "qws-trace"
            },
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // trace: Launch All  (internal — launched after build completes)
        //   Starts all three tasks in parallel. Tasks 2 and 3 use
        //   socket-wait loops so ordering is handled automatically.
        // ---------------------------------------------------------------
        {
            "label": "trace: Launch All",
            "dependsOn": [
                "trace: 1. QWS Server",
                "trace: 2. Proxy",
                "trace: 3. QWS Client"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": []
        },

        // ---------------------------------------------------------------
        // trace: Full Setup  (main entry point)
        //   Builds first, then launches all three tasks in parallel.
        // ---------------------------------------------------------------
        {
            "label": "trace: Full Setup",
            "dependsOn": [
                "Meson: Build all targets",
                "trace: Launch All"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
