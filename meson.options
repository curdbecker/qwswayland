option('build_proxy', type: 'boolean', value: true,
  description: 'Build the qwswayland proxy executable')

option('build_example', type: 'boolean', value: true,
  description: 'Build the Qt 4.8 QWS example')

option('build_trace_proxy', type: 'boolean', value: true,
  description: 'Build the qws_trace_proxy debugging tool')

option('ipc_backend', type: 'combo', choices: ['sysv', 'posix'], value: 'sysv',
  description: 'IPC backend for semaphores and shared memory (match your Qt build)')

option('build_screen_interposers', type: 'boolean', value: true,
  description: 'Build LD_PRELOAD screen interposer libraries')