# Qt 4.8 QWS example — built via qmake shadow build + make
qt4_bin_dir = get_option('qt4_bin_dir')

# qmake is a shell script that locates sibling tools via PATH.
qt_env = environment()
qt_env.prepend('PATH', qt4_bin_dir)

qmake = find_program(qt4_bin_dir / 'qmake', required: true)
src_dir   = meson.current_source_dir()
build_dir = meson.current_build_dir()

# Step 1: run qmake FROM the build dir, passing the absolute path to the .pro
# file. When the cwd differs from the .pro file's directory, qmake activates
# shadow-build mode: it writes the Makefile to the build dir and adds a VPATH
# entry so make can find the source files.
qmake_makefile = custom_target('example-qmake',
  output: 'Makefile',
  command: [
    'sh', '-c', 'cd "$1" && "$2" "$3"',
    '--', build_dir, qmake.full_path(), src_dir / 'example.pro',
  ],
  env: qt_env,
)

# Step 2: run make in the build dir (where the generated Makefile lives).
# compile_commands.json is generated by wrapping the full meson build with
# bear at the VSCode task level (see .vscode/tasks.json), which captures
# compiler invocations from both ninja and make in a single pass.
custom_target('example',
  input: files('main.cpp', 'mainwindow.cpp', 'mainwindow.h', 'example.qrc'),
  output: 'example',
  depends: qmake_makefile,
  command: ['make', '-C', build_dir],
  build_by_default: true,
  console: true,
  env: qt_env,
)
